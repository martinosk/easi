{
  "name": "EASI Dev",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "workspace",
  "runServices": ["workspace", "postgres", "migrate", "dex", "pgadmin"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.1",
      "golangciLintVersion": "2.13.2"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "node",
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "GOPATH": "/home/node/go"
  },
  "remoteEnv": {
    "PATH": "/usr/local/go/bin:/home/node/go/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Backend (API)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "biomejs.biome",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "go.lintTool": "golangci-lint",
        "go.toolsManagement.checkForUpdates": "off",
        "biome.lsp.bin": "frontend/node_modules/.bin/biome",
        "editor.formatOnSave": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        },
        "[javascript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "initializeCommand": "bash .devcontainer/cs-env.sh",
  "onCreateCommand": "sudo chown -R node:node /home/node/go /home/node/.npm /home/node/.claude /workspace/frontend/node_modules",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
