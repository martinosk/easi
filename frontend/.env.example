# API Configuration
# Set this to the backend API URL
# For local development, use: http://localhost:8080
# For production, this is set during Docker build
VITE_API_URL=http://localhost:8080

# Contract-first mock API (MSW). When "true", the app runs entirely against the in-browser
# mock with no backend (see `npm run dev:mock`). MUST default to false; never enable in prod.
VITE_USE_MOCK_API=false
